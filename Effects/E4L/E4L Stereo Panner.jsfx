desc: E4L Stereo Panner (3rd order ambisonics)
//tags: ambisonics spatial panner envelop e4l
//author: Port of Envelop for Live (E4L) to REAPER
//
// Port of "E4L Stereo Panner.amxd" from Envelop for Live (https://github.com/EnvelopSound/EnvelopForLive)
// Copyright (C) Envelop / Mark C. Slee and contributors. REAPER port: GPLv2 or later, see LICENSE.
//
// Encodes a stereo signal into 16 channels of 3rd order ambisonics (ambiX: ACN / SN3D),
// with the E4L azimuth / elevation / spread LFOs (free or tempo-synced).
//
// Routing: set the track to 16 channels, send it (channels 1-16 -> 1-16) to the track
// that holds "E4L Master Bus", and disable the track's master/parent send.

slider1:azim=0<-180,180,0.1>Azimuth
slider2:elev=0<-90,90,0.1>Elevation
slider3:radius=1<0,1,0.001>Radius
slider4:range=10<1,40,0.01>Range
slider5:azsp=30<-180,180,0.1>Azimuth Spread
slider6:elsp=0<-90,90,0.1>Elevation Spread

slider10:a_on=0<0,1,1{Off,On}>Azimuth LFO On/Off
slider11:a_mode=0<0,1,1{Cycle,Sin}>Azimuth LFO Mode
slider12:a_tmode=0<0,1,1{Freq,Sync}>Azimuth LFO Time Mode
slider13:a_freq=1<0.1,10,0.01>Azimuth LFO Frequency (Hz)
slider14:a_rate=1<-1,1,0.001>Azimuth LFO Rate
slider15:a_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Azimuth LFO Sync (bars)
slider16:a_dir=0<0,1,1{Clockwise,Counter}>Azimuth LFO Direction
slider17:a_depth=30<0,180,0.1>Azimuth LFO Depth

slider20:e_on=0<0,1,1{Off,On}>Elevation LFO On/Off
slider21:e_pol=0<0,1,1{Unipolar,Bipolar}>Elevation LFO Polarity
slider22:e_tmode=0<0,1,1{Freq,Sync}>Elevation LFO Time Mode
slider23:e_freq=1<0.1,10,0.01>Elevation LFO Frequency (Hz)
slider24:e_rate=1<-1,1,0.001>Elevation LFO Rate
slider25:e_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Elevation LFO Sync (bars)
slider26:e_dir=0<0,1,1{Clockwise,Counter}>Elevation LFO Direction
slider27:e_depth=30<0,90,0.1>Elevation LFO Depth

slider30:as_on=0<0,1,1{Off,On}>Azimuth Spread LFO On/Off
slider31:as_tmode=0<0,1,1{Freq,Sync}>Azimuth Spread LFO Mode
slider32:as_freq=1<0.01,4,0.001>Azimuth Spread LFO Frequency (Hz)
slider33:as_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Azimuth Spread LFO Sync (bars)
slider34:as_depth=30<0,180,0.1>Azimuth Spread LFO Depth

slider40:es_on=0<0,1,1{Off,On}>Elevation Spread LFO On/Off
slider41:es_tmode=0<0,1,1{Freq,Sync}>Elevation Spread LFO Mode
slider42:es_freq=1<0.01,4,0.001>Elevation Spread LFO Frequency (Hz)
slider43:es_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Elevation Spread LFO Sync (bars)
slider44:es_depth=30<0,90,0.1>Elevation Spread LFO Depth

// read-only, published for the "E4L - Live Panel" script (hidden in the plugin UI)
slider45:w_on=0<0,1,1{Off,On}>Random Wander On/Off
slider46:w_tmode=0<0,1,1{Freq,Sync}>Random Wander Time Mode
slider47:w_freq=0.25<0.02,4,0.001>Random Wander Rate (Hz)
slider48:w_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Random Wander Sync (bars)
slider49:w_area=1<0,1,0.01>Random Wander Area
slider60:0<-180,180,0.1>-Current Azimuth
slider61:0<-90,90,0.1>-Current Elevation
slider63:0<0,2,0.001>-Current Distance
slider62:0<-180,180,0.1>-Current Spread

import e4l_ambix.jsfx-inc
import e4l_gfx.jsfx-inc

in_pin:Left
in_pin:Right
out_pin:W (ACN 0)
out_pin:Y (ACN 1)
out_pin:Z (ACN 2)
out_pin:X (ACN 3)
out_pin:ACN 4
out_pin:ACN 5
out_pin:ACN 6
out_pin:ACN 7
out_pin:ACN 8
out_pin:ACN 9
out_pin:ACN 10
out_pin:ACN 11
out_pin:ACN 12
out_pin:ACN 13
out_pin:ACN 14
out_pin:ACN 15

@init
ext_tail_size = -1;
ext_noinit = 1;      // keep the movement (LFO phases) when REAPER starts / resumes

// memory map
shL = 0;    shR = 16;     // raw SH of each side
curL = 32;  incL = 48;  tgtL = 64;
curR = 80;  incR = 96;  tgtR = 112;

first = 1;
ctr = 0;
alfo.lfo_reset(); elfo.lfo_reset(); aslfo.lfo_reset(); eslfo.lfo_reset();

// Current (modulated) positions, also shown in the UI
cur_az = 0; cur_el = 0; cur_azsp = 0; cur_elsp = 0;

function compute_targets(bpos, n) local(az, el, sp_az, sp_el, rad)
(
  az    = alfo.e4l_azim_lfo(azim, a_on, a_mode, a_tmode, a_freq, a_rate, a_sync, a_dir, a_depth, bpos, n);
  el    = elfo.e4l_pol_lfo(elev, e_on, e_pol, e_tmode, e_freq, e_rate, e_sync, e_dir, e_depth, bpos, n);
  sp_az = aslfo.e4l_spread_lfo(azsp, as_on, as_tmode, as_freq, as_sync, as_depth, bpos, n);
  sp_el = eslfo.e4l_spread_lfo(elsp, es_on, es_tmode, es_freq, es_sync, es_depth, bpos, n);

  // random wander: the pair goes around inside the room (the direction / rotation turn it)
  wlfo.e4l_wander(w_on, w_tmode, w_freq, w_sync, w_area, bpos, n);
  rad = radius;
  wander_d >= 0 ? ( az += wander_az; rad = wander_d / max(range, 1); );
  cur_d = rad * range;
  cur_az = e4l_wrap180(az); cur_el = el; cur_azsp = sp_az; cur_elsp = sp_el;

  // As in E4L: left = azimuth - spread / elevation + spread, right = the opposite
  e4l_encode_target(az - sp_az, el + sp_el, rad, range, shL, tgtL);
  e4l_encode_target(az + sp_az, el - sp_el, rad, range, shR, tgtR);
);

@block
// publish the modulated position for the Live Panel, about 30 times per second
pub_ctr += samplesblock;
pub_ctr >= srate / 30 ? (
  pub_ctr = 0;
  abs(cur_az - slider60) > 0.2 ? ( slider60 = cur_az; sliderchange(slider60); );
  abs(cur_el - slider61) > 0.2 ? ( slider61 = cur_el; sliderchange(slider61); );
  abs(cur_d - slider63) > 0.01 ? ( slider63 = cur_d; sliderchange(slider63); );
  abs(cur_azsp - slider62) > 0.2 ? ( slider62 = cur_azsp; sliderchange(slider62); );
);
blk_beat = beat_position;
blk_spb  = tempo / 60 / srate;   // beats per sample

@sample
ctr <= 0 ? (
  compute_targets(blk_beat, E4L_CTRL);
  first ? (
    memcpy(curL, tgtL, 16); memcpy(curR, tgtR, 16);
    memset(incL, 0, 16);    memset(incR, 0, 16);
    first = 0;
  ) : (
    enc_set_target(curL, tgtL, incL, E4L_CTRL);
    enc_set_target(curR, tgtR, incR, E4L_CTRL);
  );
  ctr = E4L_CTRL;
);
ctr -= 1;
blk_beat += blk_spb;

enc_step(curL, incL);
enc_step(curR, incR);

inL = spl0; inR = spl1;
spl0  = inL*curL[0]  + inR*curR[0];
spl1  = inL*curL[1]  + inR*curR[1];
spl2  = inL*curL[2]  + inR*curR[2];
spl3  = inL*curL[3]  + inR*curR[3];
spl4  = inL*curL[4]  + inR*curR[4];
spl5  = inL*curL[5]  + inR*curR[5];
spl6  = inL*curL[6]  + inR*curR[6];
spl7  = inL*curL[7]  + inR*curR[7];
spl8  = inL*curL[8]  + inR*curR[8];
spl9  = inL*curL[9]  + inR*curR[9];
spl10 = inL*curL[10] + inR*curR[10];
spl11 = inL*curL[11] + inR*curR[11];
spl12 = inL*curL[12] + inR*curR[12];
spl13 = inL*curL[13] + inR*curR[13];
spl14 = inL*curL[14] + inR*curR[14];
spl15 = inL*curL[15] + inR*curR[15];

@gfx 320 340
e4l_draw_header("E4L Stereo Panner");
e4l_draw_top_view(cur_az - cur_azsp, cur_el + cur_elsp, radius, 0.2, 0.6, 1.0, "L");
e4l_draw_top_view(cur_az + cur_azsp, cur_el - cur_elsp, radius, 1.0, 0.45, 0.3, "R");
