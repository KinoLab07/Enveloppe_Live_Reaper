desc: E4L Multi-Panner (3rd order ambisonics)
//tags: ambisonics spatial panner envelop e4l multichannel
//author: Port of Envelop for Live (E4L) to REAPER
//
// Port of "E4L Multi-Panner.amxd" from Envelop for Live (https://github.com/EnvelopSound/EnvelopForLive)
// Copyright (C) Envelop / Mark C. Slee and contributors. REAPER port: GPLv2 or later, see LICENSE.
//
// Encodes up to 16 inputs (track channels 1-16) into 16 channels of 3rd order ambisonics
// (ambiX: ACN / SN3D). Each input has its own azimuth / elevation / radius offset, and the
// whole group is moved, scaled and animated with the global controls and the E4L LFOs:
//
//   azimuth(n)   = Azimuth   + Input n Azimuth   * Azimuth Scale
//   elevation(n) = Elevation + Input n Elevation * Elevation Scale
//   radius(n)    = max(0, Radius + Input n Radius * Radius Scale)
//
// Routing: set the track to 16 channels, send it (channels 1-16 -> 1-16) to the
// "E4L Master Bus" track, and disable the track's master send.

slider1:azim=0<-180,180,0.1>Azimuth
slider2:elev=0<-90,90,0.1>Elevation
slider3:radius=1<0,2,0.001>Radius
slider4:range=10<1,40,0.01>Range
slider5:azscale=1<0,2,0.001>Azimuth Scale
slider6:elscale=1<0,2,0.001>Elevation Scale
slider7:rscale=1<0,2,0.001>Radius Scale

slider10:a_on=0<0,1,1{Off,On}>Azimuth LFO On/Off
slider11:a_mode=0<0,1,1{Cycle,Sin}>Azimuth LFO Mode
slider12:a_tmode=0<0,1,1{Freq,Sync}>Azimuth LFO Time Mode
slider13:a_freq=1<0.1,10,0.01>Azimuth LFO Frequency (Hz)
slider14:a_rate=1<-1,1,0.001>Azimuth LFO Rate
slider15:a_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Azimuth LFO Sync (bars)
slider16:a_dir=0<0,1,1{Clockwise,Counter}>Azimuth LFO Direction
slider17:a_depth=30<0,180,0.1>Azimuth LFO Depth

slider20:e_on=0<0,1,1{Off,On}>Elevation LFO On/Off
slider21:e_pol=0<0,1,1{Unipolar,Bipolar}>Elevation LFO Polarity
slider22:e_tmode=0<0,1,1{Freq,Sync}>Elevation LFO Time Mode
slider23:e_freq=1<0.1,10,0.01>Elevation LFO Frequency (Hz)
slider24:e_rate=1<-1,1,0.001>Elevation LFO Rate
slider25:e_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Elevation LFO Sync (bars)
slider26:e_dir=0<0,1,1{Clockwise,Counter}>Elevation LFO Direction
slider27:e_depth=30<0,90,0.1>Elevation LFO Depth

slider30:as_on=0<0,1,1{Off,On}>Azimuth Scale LFO On/Off
slider31:as_pol=0<0,1,1{Unipolar,Bipolar}>Azimuth Scale LFO Polarity
slider32:as_tmode=0<0,1,1{Freq,Sync}>Azimuth Scale LFO Time Mode
slider33:as_freq=1<0.1,10,0.01>Azimuth Scale LFO Frequency (Hz)
slider34:as_rate=1<-1,1,0.001>Azimuth Scale LFO Rate
slider35:as_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Azimuth Scale LFO Sync (bars)
slider36:as_dir=0<0,1,1{Clockwise,Counter}>Azimuth Scale LFO Direction
slider37:as_depth=0.5<-1,1,0.001>Azimuth Scale LFO Depth

slider40:es_on=0<0,1,1{Off,On}>Elevation Scale LFO On/Off
slider41:es_pol=0<0,1,1{Unipolar,Bipolar}>Elevation Scale LFO Polarity
slider42:es_tmode=0<0,1,1{Freq,Sync}>Elevation Scale LFO Time Mode
slider43:es_freq=1<0.1,10,0.01>Elevation Scale LFO Frequency (Hz)
slider44:es_rate=1<-1,1,0.001>Elevation Scale LFO Rate
slider45:es_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Elevation Scale LFO Sync (bars)
slider46:es_dir=0<0,1,1{Clockwise,Counter}>Elevation Scale LFO Direction
slider47:es_depth=0.5<-1,1,0.001>Elevation Scale LFO Depth

slider50:in1_on=1<0,1,1{Off,On}>Input 1 Active
slider51:in1_az=0<-180,180,0.1>Input 1 Azimuth
slider52:in1_el=0<-90,90,0.1>Input 1 Elevation
slider53:in1_r=0<-1,1,0.001>Input 1 Radius
slider54:in2_on=1<0,1,1{Off,On}>Input 2 Active
slider55:in2_az=0<-180,180,0.1>Input 2 Azimuth
slider56:in2_el=0<-90,90,0.1>Input 2 Elevation
slider57:in2_r=0<-1,1,0.001>Input 2 Radius
slider58:in3_on=1<0,1,1{Off,On}>Input 3 Active
slider59:in3_az=0<-180,180,0.1>Input 3 Azimuth
slider60:in3_el=0<-90,90,0.1>Input 3 Elevation
slider61:in3_r=0<-1,1,0.001>Input 3 Radius
slider62:in4_on=1<0,1,1{Off,On}>Input 4 Active
slider63:in4_az=0<-180,180,0.1>Input 4 Azimuth
slider64:in4_el=0<-90,90,0.1>Input 4 Elevation
slider65:in4_r=0<-1,1,0.001>Input 4 Radius
slider66:in5_on=1<0,1,1{Off,On}>Input 5 Active
slider67:in5_az=0<-180,180,0.1>Input 5 Azimuth
slider68:in5_el=0<-90,90,0.1>Input 5 Elevation
slider69:in5_r=0<-1,1,0.001>Input 5 Radius
slider70:in6_on=1<0,1,1{Off,On}>Input 6 Active
slider71:in6_az=0<-180,180,0.1>Input 6 Azimuth
slider72:in6_el=0<-90,90,0.1>Input 6 Elevation
slider73:in6_r=0<-1,1,0.001>Input 6 Radius
slider74:in7_on=1<0,1,1{Off,On}>Input 7 Active
slider75:in7_az=0<-180,180,0.1>Input 7 Azimuth
slider76:in7_el=0<-90,90,0.1>Input 7 Elevation
slider77:in7_r=0<-1,1,0.001>Input 7 Radius
slider78:in8_on=1<0,1,1{Off,On}>Input 8 Active
slider79:in8_az=0<-180,180,0.1>Input 8 Azimuth
slider80:in8_el=0<-90,90,0.1>Input 8 Elevation
slider81:in8_r=0<-1,1,0.001>Input 8 Radius
slider82:in9_on=1<0,1,1{Off,On}>Input 9 Active
slider83:in9_az=0<-180,180,0.1>Input 9 Azimuth
slider84:in9_el=0<-90,90,0.1>Input 9 Elevation
slider85:in9_r=0<-1,1,0.001>Input 9 Radius
slider86:in10_on=1<0,1,1{Off,On}>Input 10 Active
slider87:in10_az=0<-180,180,0.1>Input 10 Azimuth
slider88:in10_el=0<-90,90,0.1>Input 10 Elevation
slider89:in10_r=0<-1,1,0.001>Input 10 Radius
slider90:in11_on=1<0,1,1{Off,On}>Input 11 Active
slider91:in11_az=0<-180,180,0.1>Input 11 Azimuth
slider92:in11_el=0<-90,90,0.1>Input 11 Elevation
slider93:in11_r=0<-1,1,0.001>Input 11 Radius
slider94:in12_on=1<0,1,1{Off,On}>Input 12 Active
