slider96:in12_el=0<-90,90,0.1>Input 12 Elevation
slider97:in12_r=0<-1,1,0.001>Input 12 Radius
slider98:in13_on=1<0,1,1{Off,On}>Input 13 Active
slider99:in13_az=0<-180,180,0.1>Input 13 Azimuth
slider100:in13_el=0<-90,90,0.1>Input 13 Elevation
slider101:in13_r=0<-1,1,0.001>Input 13 Radius
slider102:in14_on=1<0,1,1{Off,On}>Input 14 Active
slider103:in14_az=0<-180,180,0.1>Input 14 Azimuth
slider104:in14_el=0<-90,90,0.1>Input 14 Elevation
slider105:in14_r=0<-1,1,0.001>Input 14 Radius
slider106:in15_on=1<0,1,1{Off,On}>Input 15 Active
