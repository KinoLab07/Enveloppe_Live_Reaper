slider113:in16_r=0<-1,1,0.001>Input 16 Radius

import e4l_ambix.jsfx-inc
import e4l_gfx.jsfx-inc

in_pin:Input 1
in_pin:Input 2
in_pin:Input 3
in_pin:Input 4
in_pin:Input 5
in_pin:Input 6
in_pin:Input 7
in_pin:Input 8
in_pin:Input 9
in_pin:Input 10
in_pin:Input 11
in_pin:Input 12
in_pin:Input 13
in_pin:Input 14
in_pin:Input 15
in_pin:Input 16
out_pin:W (ACN 0)
out_pin:Y (ACN 1)
out_pin:Z (ACN 2)
out_pin:X (ACN 3)
out_pin:ACN 4
out_pin:ACN 5
out_pin:ACN 6
out_pin:ACN 7
out_pin:ACN 8
out_pin:ACN 9
out_pin:ACN 10
out_pin:ACN 11
out_pin:ACN 12
out_pin:ACN 13
out_pin:ACN 14
out_pin:ACN 15

@init
ext_tail_size = -1;

// memory map: 16 sources x (cur, inc, tgt) of 16 values, plus scratch
sh  = 0;
cur = 1000;   // cur + 16*k
inc = 1300;
tgt = 1600;
pos_az = 2000; pos_el = 2020; pos_r = 2040; active = 2060;
xin = 2100;

first = 1;
ctr = 0;
alfo.lfo_reset(); elfo.lfo_reset(); aslfo.lfo_reset(); eslfo.lfo_reset();

// slider(50 + 4*k ...) are the per-input controls
function compute_targets(bpos, n) local(az, el, azs, els, k, b, r)
(
  az  = alfo.e4l_azim_lfo(azim, a_on, a_mode, a_tmode, a_freq, a_rate, a_sync, a_dir, a_depth, bpos, n);
  el  = elfo.e4l_pol_lfo(elev, e_on, e_pol, e_tmode, e_freq, e_rate, e_sync, e_dir, e_depth, bpos, n);
  azs = aslfo.e4l_pol_lfo(azscale, as_on, as_pol, as_tmode, as_freq, as_rate, as_sync, as_dir, as_depth, bpos, n);
  els = eslfo.e4l_pol_lfo(elscale, es_on, es_pol, es_tmode, es_freq, es_rate, es_sync, es_dir, es_depth, bpos, n);

  k = 0;
  loop(16,
    b = 50 + 4*k;
    active[k] = slider(b) >= 0.5;
    pos_az[k] = az + slider(b+1) * azs;
    pos_el[k] = el + slider(b+2) * els;
    pos_r[k]  = r = max(0, radius + slider(b+3) * rscale);
    active[k] ? e4l_encode_target(pos_az[k], pos_el[k], r, range, sh, tgt + 16*k)
              : memset(tgt + 16*k, 0, 16);
    k += 1;
  );
);

@block
blk_beat = beat_position;
blk_spb  = tempo / 60 / srate;

@sample
ctr <= 0 ? (
  compute_targets(blk_beat, E4L_CTRL);
  first ? (
    memcpy(cur, tgt, 256); memset(inc, 0, 256); first = 0;
  ) : (
    k = 0;
    loop(16, enc_set_target(cur + 16*k, tgt + 16*k, inc + 16*k, E4L_CTRL); k += 1; );
  );
  ctr = E4L_CTRL;
);
ctr -= 1;
blk_beat += blk_spb;

xin[0]  = spl0;  xin[1]  = spl1;  xin[2]  = spl2;  xin[3]  = spl3;
xin[4]  = spl4;  xin[5]  = spl5;  xin[6]  = spl6;  xin[7]  = spl7;
xin[8]  = spl8;  xin[9]  = spl9;  xin[10] = spl10; xin[11] = spl11;
xin[12] = spl12; xin[13] = spl13; xin[14] = spl14; xin[15] = spl15;
spl0 = spl1 = spl2 = spl3 = spl4 = spl5 = spl6 = spl7 = 0;
spl8 = spl9 = spl10 = spl11 = spl12 = spl13 = spl14 = spl15 = 0;

k = 0;
loop(16,
  c = cur + 16*k; d = inc + 16*k;
  // skip inputs that are off and fully faded out
  (active[k] || c[0] != 0) ? (
    enc_step(c, d);
    abs(c[0]) < 0.000000001 && !active[k] ? memset(c, 0, 16);
    x = xin[k];
    spl0  += x*c[0];  spl1  += x*c[1];  spl2  += x*c[2];  spl3  += x*c[3];
    spl4  += x*c[4];  spl5  += x*c[5];  spl6  += x*c[6];  spl7  += x*c[7];
    spl8  += x*c[8];  spl9  += x*c[9];  spl10 += x*c[10]; spl11 += x*c[11];
    spl12 += x*c[12]; spl13 += x*c[13]; spl14 += x*c[14]; spl15 += x*c[15];
  );
  k += 1;
);

@gfx 320 340
e4l_draw_header("E4L Multi-Panner");
gfx_setfont(1, "Arial", 12);
k = 0;
loop(16,
  active[k] ? (
    a = pos_az[k] * $pi / 180; e = pos_el[k] * $pi / 180;
    dd = cos(e) * e4l_r * max(0.05, min(pos_r[k] / 2, 1));
    xx = e4l_cx + sin(a) * dd; yy = e4l_cy - cos(a) * dd;
    gfx_set(0.3 + 0.04*k, 0.85 - 0.03*k, 0.6, 0.9);
    gfx_circle(xx, yy, 6 + 3 * sin(e), 1, 1);
    gfx_set(1, 1, 1, 1); gfx_x = xx + 8; gfx_y = yy - 6; gfx_printf("%d", k + 1);
  );
  k += 1;
);
