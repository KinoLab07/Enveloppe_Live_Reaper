desc: E4L Looper (bar-synced live looper)
//tags: looper live loop record envelop e4l
//author: Envelop for REAPER
//
// Ableton-style live looper for one loop track. GPLv2 or later, see LICENSE.
//
// Records the audio that reaches this track (inputs 1-2, normally a send from the
// "SYNTH IN" track) into a loop of N bars, starting exactly on the next bar of the
// REAPER timeline, then plays it back in sync with the project tempo. Put an E4L
// panner after it to spatialise the loop.
//
//   REC      : waits for the next bar, records "Length" bars, then plays the loop.
//              On a track that already has a loop, REC records a new one.
//   PLAY     : starts (or stops) the loop on the next bar.
//   OVERDUB  : while playing, adds what comes in on top of the loop.
//   CLEAR    : erases the loop.
//
// REAPER must be playing: the loop follows the project position (bars and tempo).
// Everything can be MIDI-learned (Param > Learn) or clicked in the plugin window.

slider1:len_sel=2<0,5,1{1,2,4,8,16,32}>Length (bars)
slider2:rec_btn=0<0,1,1{Off,On}>Record
slider3:play_btn=0<0,1,1{Off,On}>Play
slider4:odub_btn=0<0,1,1{Off,On}>Overdub
slider5:clear_btn=0<0,1,1{-,Clear}>Clear
slider6:vol_db=0<-60,12,0.1>Loop Volume (dB)
slider7:thru=0<0,1,1{Off,On}>Input Thru (live input also to the output)
slider8:lat_ms=0<0,500,0.1>Recording Latency Compensation (ms)

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R

options:maxmem=32000000

@init
ext_tail_size = -1;
ext_noinit = 1;      // keep the recorded loop when playback stops / restarts

BUF = 0;
MAXSAMP = floor((32000000 - 1024) / 2);   // stereo frames available

// states (armed = waiting for the next bar to start recording)
ST_EMPTY = 0; ST_REC = 2; ST_PLAY = 3; ST_STOP = 4;
state = ST_EMPTY;
armed = 0;
has_loop = 0;
loop_len = 0;          // frames
loop_qn = 0;           // length in quarter notes
start_qn = 0;          // project position (quarter notes) where the loop starts
pend_play = 0; pend_stop = 0;
recording = 0; rec_count = 0;
last_bar = -1;
err_msg = 0;
p_rec = p_play = p_clear = 0;   // previous button values (edge detection)

function bars_from_sel(s) ( s == 0 ? 1 : s == 1 ? 2 : s == 2 ? 4 : s == 3 ? 8 : s == 4 ? 16 : 32; );

function set_slider(idx, val) local(m)
(
  slider(idx) = val;
  m = 2 ^ (idx - 1);
  slider_automate(m);
);

function do_clear()
(
  state = ST_EMPTY; has_loop = 0; recording = 0; armed = 0;
  pend_play = pend_stop = 0; loop_len = 0;
  play_btn != 0 ? set_slider(3, 0);
  rec_btn != 0 ? set_slider(2, 0);
  odub_btn != 0 ? set_slider(4, 0);
);

// fade the first / last frames of the loop so the seam does not click
function fade_edges() local(n, i, g)
(
  n = min(floor(srate * 0.003), floor(loop_len / 4));
  i = 0;
  loop(n,
    g = i / n;
    BUF[2*i] *= g; BUF[2*i+1] *= g;
    BUF[2*(loop_len-1-i)] *= g; BUF[2*(loop_len-1-i)+1] *= g;
    i += 1;
  );
);

@slider
gain = 10 ^ (vol_db / 20);

@block
// ---------- buttons (UI clicks, automation, MIDI learn): react to changes ----------
rec_btn && !p_rec && state != ST_REC ? ( armed = 1; err_msg = 0; );
!rec_btn && p_rec && armed ? armed = 0;
clear_btn && !p_clear ? ( do_clear(); set_slider(5, 0); );
play_btn && !p_play && has_loop && state == ST_STOP ? ( pend_play = 1; pend_stop = 0; );
play_btn && !p_play && state == ST_PLAY ? pend_stop = 0;
!play_btn && p_play && state == ST_PLAY ? ( pend_stop = 1; pend_play = 0; );
!play_btn && p_play && state == ST_STOP ? pend_play = 0;
p_rec = rec_btn; p_play = play_btn; p_clear = clear_btn;

gain = 10 ^ (vol_db / 20);
qn_per_spl = tempo / 60 / srate;
bar_qn = ts_num * 4 / max(ts_denom, 1);
lat_qn = lat_ms / 1000 * tempo / 60;
playing_now = play_state & 1;
b = beat_position;
!playing_now ? ( last_bar = -1; );

@sample
inL = spl0; inR = spl1;
outL = outR = 0;

playing_now ? (
  // ---------- bar boundaries (quantisation) ----------
  cur_bar = floor(b / bar_qn + 0.0000001);
  at_boundary = cur_bar != last_bar && (last_bar >= 0 || (b - cur_bar * bar_qn) < 2 * qn_per_spl);
  last_bar = cur_bar;

  at_boundary ? (
    armed ? (
      armed = 0;
      bars = bars_from_sel(len_sel);
      loop_qn = bars * bar_qn;
      loop_len = floor(loop_qn / qn_per_spl + 0.5);
      loop_len > MAXSAMP ? (
        // too long for the available memory at this tempo
        err_msg = 1; set_slider(2, 0); p_rec = 0;
      ) : (
        new_start = cur_bar * bar_qn;
        state = ST_REC; recording = 1; rec_count = 0;
        rec_start_qn = new_start;
        has_loop = 0;            // the previous loop is replaced
      );
    );
    pend_play ? ( state = ST_PLAY; pend_play = 0; );
    pend_stop ? ( state = ST_STOP; pend_stop = 0; );
  );

  // ---------- recording (sample counter, shifted by the latency compensation) ----------
  recording ? (
    rb = b - lat_qn;
    rb >= rec_start_qn - 0.5 * qn_per_spl ? (
      rec_count < loop_len ? (
        BUF[2*rec_count] = inL; BUF[2*rec_count+1] = inR;
        rec_count += 1;
      );
      rec_count >= loop_len ? (
        recording = 0;
        fade_edges();
      );
    );
  );
  // the loop starts playing right after its last bar, even if the latency
  // compensation is still writing its last few milliseconds
  state == ST_REC && b >= rec_start_qn + loop_qn ? (
    start_qn = rec_start_qn; has_loop = 1;
    state = ST_PLAY;
    set_slider(2, 0); p_rec = 0;
    play_btn == 0 ? ( set_slider(3, 1); p_play = 1; );
  );

  // ---------- playback / overdub ----------
  has_loop && state == ST_PLAY ? (
    ph = (b - start_qn) / loop_qn; ph -= floor(ph);
    pos = ph * loop_len;
    i0 = floor(pos); fr = pos - i0;
    i1 = i0 + 1; i1 >= loop_len ? i1 = 0;
    i0 >= loop_len ? i0 = loop_len - 1;
    outL = BUF[2*i0]   + (BUF[2*i1]   - BUF[2*i0])   * fr;
    outR = BUF[2*i0+1] + (BUF[2*i1+1] - BUF[2*i0+1]) * fr;

    odub_btn ? (
      ph2 = (b - lat_qn - start_qn) / loop_qn; ph2 -= floor(ph2);
      k = floor(ph2 * loop_len + 0.5); k >= loop_len ? k -= loop_len;
      BUF[2*k] += inL; BUF[2*k+1] += inR;
    );
  );

  b += qn_per_spl;
);

spl0 = outL * gain + (thru ? inL : 0);
spl1 = outR * gain + (thru ? inR : 0);

@gfx 360 210
// ---------- display + clickable buttons ----------
gfx_set(0.08, 0.08, 0.1, 1); gfx_rect(0, 0, gfx_w, gfx_h);
gfx_setfont(1, "Arial", 14);
gfx_set(0.85, 0.85, 0.9, 1); gfx_x = 8; gfx_y = 6; gfx_drawstr("E4L Looper");

// state label
gfx_setfont(2, "Arial", 26, 'b');
state == ST_EMPTY ? ( gfx_set(0.55, 0.55, 0.6, 1); lbl = "EMPTY"; );
state == ST_REC   ? ( gfx_set(1, 0.25, 0.25, 1); lbl = "REC"; );
state == ST_PLAY  ? ( gfx_set(0.3, 0.9, 0.4, 1); lbl = odub_btn ? "PLAY + OVERDUB" : "PLAY"; );
state == ST_STOP  ? ( gfx_set(0.6, 0.75, 0.9, 1); lbl = "STOPPED"; );
armed ? ( gfx_set(1, 0.6, 0.2, 1); lbl = "ARMED - next bar"; );
gfx_x = 8; gfx_y = 26; gfx_drawstr(lbl);

gfx_setfont(1, "Arial", 13);
gfx_set(0.7, 0.7, 0.75, 1);
gfx_x = 8; gfx_y = 60;
gfx_printf("Length %d bars", bars_from_sel(len_sel));
pend_play ? gfx_drawstr("   (starts next bar)");
pend_stop ? gfx_drawstr("   (stops next bar)");
!(play_state & 1) ? ( gfx_set(1, 0.7, 0.3, 1); gfx_x = 8; gfx_y = 76;
  gfx_drawstr("Press play in REAPER to record / play loops"); );
err_msg ? ( gfx_set(1, 0.4, 0.3, 1); gfx_x = 8; gfx_y = 76;
  gfx_drawstr("Loop too long at this tempo: choose fewer bars"); );

// position bar with bar ticks
px = 8; py = 96; pw = gfx_w - 16; ph_ = 14;
gfx_set(0.2, 0.2, 0.24, 1); gfx_rect(px, py, pw, ph_);
(state == ST_PLAY || state == ST_REC) && loop_qn > 0 ? (
  bb = beat_position;
  ref = state == ST_REC ? rec_start_qn : start_qn;
  pp = (bb - ref) / loop_qn; pp -= floor(pp);
  state == ST_REC ? gfx_set(1, 0.25, 0.25, 0.9) : gfx_set(0.3, 0.9, 0.4, 0.9);
  gfx_rect(px, py, pw * pp, ph_);
);
nb = bars_from_sel(len_sel); has_loop && bar_qn > 0 ? nb = floor(loop_qn / bar_qn + 0.5);
gfx_set(0.5, 0.5, 0.55, 1);
k = 1; loop(nb - 1, gfx_line(px + pw * k / nb, py, px + pw * k / nb, py + ph_); k += 1; );

// buttons
function button(x, y, w, h, label, on, r, g, bl, idx)
(
  on ? gfx_set(r, g, bl, 1) : gfx_set(0.22, 0.22, 0.26, 1);
  gfx_rect(x, y, w, h);
  gfx_set(on ? 0.05 : 0.85, on ? 0.05 : 0.85, on ? 0.05 : 0.9, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) / 2; gfx_y = y + (h - th) / 2; gfx_drawstr(label);
  (mouse_cap & 1) && !last_cap && mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h ? (
    idx == 2 ? set_slider(2, rec_btn ? 0 : 1);
    idx == 3 ? set_slider(3, play_btn ? 0 : 1);
    idx == 4 ? set_slider(4, odub_btn ? 0 : 1);
    idx == 5 ? set_slider(5, 1);
  );
);
gfx_setfont(2, "Arial", 16, 'b');
bw = (gfx_w - 16 - 3 * 6) / 4; by = 122; bh = 40;
button(8,               by, bw, bh, "REC",     armed || state == ST_REC, 1, 0.3, 0.3, 2);
button(8 + (bw + 6),    by, bw, bh, "PLAY",    play_btn, 0.3, 0.9, 0.4, 3);
button(8 + 2*(bw + 6),  by, bw, bh, "OVERDUB", odub_btn, 1, 0.75, 0.2, 4);
button(8 + 3*(bw + 6),  by, bw, bh, "CLEAR",   0, 0.6, 0.6, 0.6, 5);
last_cap = mouse_cap & 1;

gfx_setfont(1, "Arial", 12);
gfx_set(0.55, 0.55, 0.6, 1);
gfx_x = 8; gfx_y = 172;
gfx_printf("Loop volume %.1f dB   Thru %s   Latency comp. %.1f ms", vol_db, thru ? "On" : "Off", lat_ms);
