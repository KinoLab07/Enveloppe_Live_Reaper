desc: E4L Looper (bar-synced live looper)
//tags: looper live loop record envelop e4l
//author: Envelop for REAPER
//
// Ableton-style live looper for one loop track. GPLv2 or later, see LICENSE.
//
// Records the audio that reaches this track (inputs 1-2, normally a send from the
// "SYNTH IN" track) into a loop of N bars, starting exactly on the next bar of the
// REAPER timeline, then plays it back in sync with the project tempo. Put an E4L
// panner after it to spatialise the loop.
//
//   REC      : waits for the next bar, records "Length" bars, then plays the loop.
//              On a track that already has a loop, REC records a new one.
//   PLAY     : starts the loop from its beginning on the next bar (or stops it on the next bar).
//   PAUSE    : pauses the loop now; PAUSE again continues it at once from the exact point
//              where it was paused (like a tape: it moves relative to the bars by the time it
//              was paused). PLAY puts it back on the bars, from its beginning.
//   OVERDUB  : while playing, adds what comes in on top of the loop.
//   CLEAR    : erases the loop.
//
// REAPER must be playing: the loop follows the project position (bars and tempo).
// Everything can be MIDI-learned (Param > Learn) or clicked in the plugin window.

slider1:len_sel=2<0,5,1{1,2,4,8,16,32}>Length (bars)
slider2:rec_btn=0<0,1,1{Off,On}>Record
slider3:play_btn=0<0,1,1{Off,On}>Play
slider4:odub_btn=0<0,1,1{Off,On}>Overdub
slider5:clear_btn=0<0,1,1{-,Clear}>Clear
slider6:vol_db=0<-60,12,0.1>Loop Volume (dB)
slider7:thru=0<0,1,1{Off,On}>Input Thru (live input also to the output)
slider8:lat_ms=0<0,500,0.1>Recording Latency Compensation (ms)
// read-only status, published for the "E4L - Live Panel" script (hidden in the plugin UI)
slider9:st_out=0<0,5,1>-Status (0 empty 1 armed 2 rec 3 play 4 stop 5 pause)
slider10:pend_out=0<0,3,1>-Pending (1 play 2 stop 3 resume)
slider11:bars_out=0<0,64,1>-Loop Bars
slider12:start_out=0<-1000000,100000000,0.0001>-Loop Start (QN)
slider13:qn_out=0<0,1000,0.0001>-Loop Length (QN)
// smoothing: longer = smoother with steady, unmodulated tones (bass, drones)
slider14:xf_ms=50<1,170,1>Loop Seam Crossfade (ms)
slider15:fade_ms=30<1,200,1>Start / Stop Fade (ms)
slider16:pause_btn=0<0,1,1{Off,On}>Pause
slider17:comp_mode=0<0,2,1{Auto (by pitch),Off,Full}>Seam Level Compensation

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R

options:maxmem=32000000

@init
ext_tail_size = -1;
ext_noinit = 1;      // keep the recorded loop when playback stops / restarts

BUF = 0;
XF_MAX = 8192;                            // max crossfade frames (the seam of the loop)
TAILMAX = 2048;                           // frames recorded after the loop (seam alignment)
MAXSAMP = floor((32000000 - 8 * XF_MAX - 1024) / 2);   // stereo frames available
RING = 2 * MAXSAMP + 512;                 // the last XF_MAX input frames, always
SNAP = RING + 2 * XF_MAX;                 // the input just before the recording started
XF1  = SNAP + 2 * XF_MAX;                 // seam of the first pass
XF2  = XF1 + 2 * XF_MAX;                  // seam once aligned in phase
cl = 0; nx = 0; xfb = XF1;                // content length, seam length, seam buffer in use
pend_cl = 0; job = 0;
ring_pos = 0;
env = 0;                                  // output ramp: no click when a loop starts / stops

// states (armed = waiting for the next bar to start recording)
ST_EMPTY = 0; ST_REC = 2; ST_PLAY = 3; ST_STOP = 4; ST_PAUSE = 5;
state = ST_EMPTY;
armed = 0;
has_loop = 0;
loop_len = 0;          // frames
loop_qn = 0;           // length in quarter notes
start_qn = 0;          // project position (quarter notes) where the loop starts
pend_play = 0; pend_stop = 0; pend_resume = 0;
paused_qn = 0;         // position in the loop (quarter notes) where it was paused
recording = 0; rec_count = 0;
last_bar = -1;
err_msg = 0;
p_rec = p_play = p_clear = p_pause = 0;   // previous button values (edge detection)

function bars_from_sel(s) ( s == 0 ? 1 : s == 1 ? 2 : s == 2 ? 4 : s == 3 ? 8 : s == 4 ? 16 : 32; );

function set_slider(idx, val) local(m)
(
  slider(idx) = val;
  m = 2 ^ (idx - 1);
  slider_automate(m);
);

function do_clear()
(
  state = ST_EMPTY; has_loop = 0; recording = 0; armed = 0; job = 0; pend_cl = 0; nx = 0;
  pend_play = pend_stop = pend_resume = 0; loop_len = 0;
  play_btn != 0 ? set_slider(3, 0);
  pause_btn != 0 ? ( set_slider(16, 0); p_pause = 0; );
  rec_btn != 0 ? set_slider(2, 0);
  odub_btn != 0 ? set_slider(4, 0);
);

// copy the input that came just before the first recorded frame (from the ring buffer)
function snap_preroll() local(j, r)
(
  j = 0;
  loop(XF_MAX,
    r = ring_pos - XF_MAX + j; r < 0 ? r += XF_MAX;
    SNAP[2*j] = RING[2*r]; SNAP[2*j+1] = RING[2*r+1];
    j += 1;
  );
);

// THE SEAM. When playback wraps from the end of the loop to its start, the end crossfades into
// the audio that came just before the recording (so the wave goes on into the first frame).
// With a steady tone the end and that audio are the same wave but out of phase (the loop is
// not a whole number of cycles), and any crossfade between them either dips in level or
// bends the pitch. So, after recording, the looper looks for the shift `d` (at most half a
// cycle) that brings the end in phase with the start, and from the second pass on reads the
// loop as L + d frames long: a speed change of a few cents spread over the whole loop
// instead of a jump at the seam. Non-periodic sounds (no clear match) keep d = 0.

// crossfade BUF[aend - n .. aend) into the pre-roll, written to dst (n frames)
// With a steady tone left out of phase the crossfade dips; the gains can make up for it, but
// then the phase shift becomes a pitch blip at full level, worse towards the bass, so "Auto"
// only compensates high tones. After the phase alignment both pieces match and it is a
// plain crossfade anyway.
function seam_into(dst, aend, n) local(i, g, k, s, pa, pb, c, ga, gb, p0, t0, gk, zc, prev, v, fz, amt)
(
  pa = pb = c = zc = prev = 0;
  i = 0;
  loop(n,
    k = aend - n + i; s = XF_MAX - n + i;
    pa += sqr(BUF[2*k]) + sqr(BUF[2*k+1]);
    pb += sqr(SNAP[2*s]) + sqr(SNAP[2*s+1]);
    c  += BUF[2*k] * SNAP[2*s] + BUF[2*k+1] * SNAP[2*s+1];
    v = BUF[2*k] + BUF[2*k+1];
    i > 0 && ((v >= 0) != (prev >= 0)) ? zc += 1;
    prev = v;
    i += 1;
  );
  fz = zc * srate / (2 * max(n, 1));            // rough pitch of the region (Hz)
  amt = comp_mode == 1 ? 0 : comp_mode == 2 ? 1 : min(1, max(0, (fz - 400) / 600));
  i = 0;
  loop(n,
    g = 0.5 - 0.5 * cos($pi * (i + 1) / n);
    ga = 1 - g; gb = g;
    p0 = ga * ga * pa + gb * gb * pb + 2 * ga * gb * c;
    t0 = ga * pa + gb * pb;
    // smooth limit (about x2.6 at most, exactly 1 at both ends): no kink in the curve
    gk = t0 > 0.000000000001 ? sqrt(sqrt(t0 * t0 * 1.0225) / sqrt(p0 * p0 + 0.0225 * t0 * t0)) : 1;
    gk = gk ^ amt;
    k = aend - n + i; s = XF_MAX - n + i;
    dst[2*i]   = BUF[2*k]   * ga * gk + SNAP[2*s]   * gb * gk;
    dst[2*i+1] = BUF[2*k+1] * ga * gk + SNAP[2*s+1] * gb * gk;
    i += 1;
  );
);

// how alike (Pearson correlation, mono) the CM frames before loop_len + d are to the CM
// frames before the start of the recording; st = step through the frames
function seam_corr(d, st) local(j, ka, kb, a, q, n, sa, sb, sab, saa, sbb, va, vb)
(
  sa = sb = sab = saa = sbb = n = 0;
  j = 0;
  while (j < CM) (
    ka = loop_len + d - CM + j; kb = XF_MAX - CM + j;
    a = BUF[2*ka] + BUF[2*ka+1]; q = SNAP[2*kb] + SNAP[2*kb+1];
    sa += a; sb += q; sab += a * q; saa += a * a; sbb += q * q; n += 1;
    j += st;
  );
  va = saa - sa * sa / n; vb = sbb - sb * sb / n;
  va > 0.0000000001 && vb > 0.0000000001 ? (sab - sa * sb / n) / sqrt(va * vb) : 0;
);

// the search, a few lags per audio block (it must never cause a dropout)
function seam_job_step() local(cnt, r, sc, d)
(
  job == 1 ? (                                  // coarse: every 2nd lag, every 4th frame
    cnt = 0;
    while (cnt < 32 && jd <= tail_n) (
      r = seam_corr(jd, 4);
      sc = r - 0.15 * abs(jd) / max(tail_n, 1);
      sc > best_sc ? ( best_sc = sc; best_d = jd; );
      jd += 2; cnt += 1;
    );
    jd > tail_n ? ( job = 2; jd = max(-tail_n, best_d - 2); best_sc = -10; );
  ) : job == 2 ? (                              // fine: around the best one, every frame
    d = jd;
    loop(5,
      d <= tail_n ? (
        r = seam_corr(d, 1);
        sc = r - 0.15 * abs(d) / max(tail_n, 1);
        sc > best_sc ? ( best_sc = sc; best_d = d; best_r = r; );
      );
      d += 1;
    );
    job = 0;
    // only a clearly periodic sound, and at most about 10 cents of speed change
    best_r > 0.9 && best_d != 0 && abs(best_d) <= 0.006 * loop_len ? (
      seam_into(XF2, loop_len + best_d, nx);
      pend_cl = loop_len + best_d;
    );
  );
);

// one frame of the loop content (the seam region comes from the seam buffer)
function rd(i) local(j)
(
  i < 0 ? i += cl : i >= cl ? i -= cl;
  i >= cl - nx ? ( j = i - (cl - nx); rL = xfb[2*j]; rR = xfb[2*j+1]; )
               : ( rL = BUF[2*i]; rR = BUF[2*i+1]; );
);

// 4-point cubic (Hermite) interpolation at content position p
function rd_interp(p) local(i, f, l0, l1, l2, l3, r0, r1, r2, r3)
(
  i = floor(p); f = p - i;
  rd(i - 1); l0 = rL; r0 = rR;
  rd(i);     l1 = rL; r1 = rR;
  rd(i + 1); l2 = rL; r2 = rR;
  rd(i + 2); l3 = rL; r3 = rR;
  oL = l1 + 0.5 * f * (l2 - l0 + f * (2 * l0 - 5 * l1 + 4 * l2 - l3 + f * (3 * (l1 - l2) + l3 - l0)));
  oR = r1 + 0.5 * f * (r2 - r0 + f * (2 * r0 - 5 * r1 + 4 * r2 - r3 + f * (3 * (r1 - r2) + r3 - r0)));
);

@slider
gain = 10 ^ (vol_db / 20);

@block
// ---------- buttons (UI clicks, automation, MIDI learn): react to changes ----------
rec_btn && !p_rec && state != ST_REC ? ( armed = 1; err_msg = 0; );
!rec_btn && p_rec && armed ? armed = 0;
clear_btn && !p_clear ? ( do_clear(); set_slider(5, 0); );
// PLAY: from the beginning on the next bar (also from a pause)
play_btn && !p_play && has_loop && (state == ST_STOP || state == ST_PAUSE) ? (
  pend_play = 1; pend_stop = 0; pend_resume = 0;
  pause_btn ? ( set_slider(16, 0); p_pause = 0; );
);
play_btn && !p_play && state == ST_PLAY ? pend_stop = 0;
!play_btn && p_play && state == ST_PLAY ? ( pend_stop = 1; pend_play = 0; );
!play_btn && p_play && (state == ST_STOP || state == ST_PAUSE) ? pend_play = 0;
// PAUSE: now (with the fade); PAUSE off: continue at once from the exact point
pause_btn && !p_pause ? (
  state == ST_PLAY && loop_qn > 0 ? (
    paused_qn = (beat_position - start_qn) - floor((beat_position - start_qn) / loop_qn) * loop_qn;
    state = ST_PAUSE; pend_stop = 0; pend_play = 0;
    play_btn ? ( set_slider(3, 0); p_play = 0; );
  ) : ( set_slider(16, 0); );               // nothing playing: nothing to pause
);
!pause_btn && p_pause && state == ST_PAUSE ? (
  start_qn = beat_position - paused_qn;
  state = ST_PLAY;
  play_btn == 0 ? ( set_slider(3, 1); p_play = 1; );
);
p_rec = rec_btn; p_play = play_btn; p_clear = clear_btn; p_pause = pause_btn;

// ---------- publish the status for the Live Panel (only when it changes) ----------
v = armed ? 1 : state;
v != st_out ? ( st_out = v; sliderchange(2 ^ 8); );
v = pend_play ? 1 : pend_stop ? 2 : pend_resume ? 3 : 0;
v != pend_out ? ( pend_out = v; sliderchange(2 ^ 9); );
v = state == ST_REC ? bars_from_sel(len_sel) : has_loop && bar_qn > 0 ? floor(loop_qn / bar_qn + 0.5) : 0;
v != bars_out ? ( bars_out = v; sliderchange(2 ^ 10); );
v = state == ST_REC ? rec_start_qn : start_qn;
v != start_out ? ( start_out = v; sliderchange(2 ^ 11); );
v = state == ST_REC ? bars_from_sel(len_sel) * bar_qn : loop_qn;
v != qn_out ? ( qn_out = v; sliderchange(2 ^ 12); );

job ? seam_job_step();
gain = 10 ^ (vol_db / 20);
qn_per_spl = tempo / 60 / srate;
bar_qn = ts_num * 4 / max(ts_denom, 1);
lat_qn = lat_ms / 1000 * tempo / 60;
playing_now = play_state & 1;
b = beat_position;
// like Ableton: after STOP, PLAY starts the loops from their beginning on the current bar;
// after PAUSE (play_state 2 or 6) they continue where they were
playing_now && !(prev_ps & 1) && prev_ps != 2 && prev_ps != 6 && has_loop && state != ST_REC ? (
  start_qn = floor(b / bar_qn + 0.0000001) * bar_qn;
);
prev_ps = play_state;
!playing_now ? ( last_bar = -1; env = 0; );
env_step = 1 / max(1, srate * fade_ms / 1000);

@sample
inL = spl0; inR = spl1;
outL = outR = 0;

playing_now ? (
  // ---------- bar boundaries (quantisation) ----------
  cur_bar = floor(b / bar_qn + 0.0000001);
  at_boundary = cur_bar != last_bar && (last_bar >= 0 || (b - cur_bar * bar_qn) < 2 * qn_per_spl);
  last_bar = cur_bar;

  at_boundary ? (
    armed ? (
      armed = 0;
      bars = bars_from_sel(len_sel);
      loop_qn = bars * bar_qn;
      loop_len = floor(loop_qn / qn_per_spl + 0.5);
      loop_len > MAXSAMP ? (
        // too long for the available memory at this tempo
        err_msg = 1; set_slider(2, 0); p_rec = 0;
      ) : (
        new_start = cur_bar * bar_qn;
        state = ST_REC; recording = 1; rec_count = 0;
        rec_start_qn = new_start;
        has_loop = 0;            // the previous loop is replaced
        job = 0; pend_cl = 0; nx = 0;
        tail_n = min(TAILMAX, MAXSAMP - loop_len);
      );
    );
    pend_play ? (                     // from the beginning of the loop
      state = ST_PLAY; pend_play = 0; start_qn = cur_bar * bar_qn;
    );
    pend_resume ? (                   // from the bar of the loop where it was paused
      state = ST_PLAY; pend_resume = 0;
      start_qn = cur_bar * bar_qn - floor(paused_qn / bar_qn + 0.0000001) * bar_qn;
      play_btn == 0 ? ( set_slider(3, 1); p_play = 1; );
    );
    pend_stop ? ( state = ST_STOP; pend_stop = 0; );
  );

  // ---------- recording (sample counter, shifted by the latency compensation) ----------
  recording ? (
    rb = b - lat_qn;
    rb >= rec_start_qn - 0.5 * qn_per_spl ? (
      rec_count == 0 ? snap_preroll();
      rec_count < loop_len + tail_n ? (
        BUF[2*rec_count] = inL; BUF[2*rec_count+1] = inR;
        rec_count += 1;
        rec_count == loop_len ? (           // the loop is complete: seam of the first pass
          n_new = min(min(floor(srate * xf_ms / 1000), XF_MAX), floor(loop_len / 4));
          seam_into(XF1, loop_len, n_new);
          xfb = XF1; nx = n_new;
        );
      );
      rec_count >= loop_len + tail_n ? (    // and a little more: look for the phase match
        recording = 0;
        CM = min(2048, min(XF_MAX, floor(loop_len / 4)));
        job = 1; jd = -tail_n; best_sc = -10; best_d = 0; best_r = 0;
      );
    );
  );
  // the loop starts playing right after its last bar, even if the latency
  // compensation is still writing its last few milliseconds
  state == ST_REC && b >= rec_start_qn + loop_qn ? (
    start_qn = rec_start_qn; has_loop = 1;
    cl = loop_len; prev_ph = 0;
    state = ST_PLAY;
    set_slider(2, 0); p_rec = 0;
    play_btn == 0 ? ( set_slider(3, 1); p_play = 1; );
  );

  // ---------- playback / overdub ----------
  // (after STOP it keeps reading during the fade-out)
  env = has_loop && state == ST_PLAY ? min(1, env + env_step) : max(0, env - env_step);
  !has_loop ? env = 0;
  has_loop && env > 0 ? (
    ph = (b - start_qn) / loop_qn; ph -= floor(ph);
    wrapped = ph < prev_ph - 0.5;
    wrapped || abs(ph - prev_ph) > 0.01 ? warp = 0;     // new pass, or a jump (resume...)
    // the phase-aligned length takes over: at once if silent or at the wrap; in the middle
    // of a pass, the rest of the pass is read a hair faster / slower so it ends exactly at
    // the new length (so even the first seam is aligned)
    pend_cl > 0 ? (
      env < env_step || wrapped ? (
        cl = pend_cl; xfb = XF2; pend_cl = 0; warp = 0;
      ) : ph < 0.85 ? (
        wph = ph; wpos = ph * cl;
        cl = pend_cl; xfb = XF2; pend_cl = 0; warp = 1;
      );
    );
    prev_ph = ph;
    pos = warp ? wpos + (ph - wph) * (cl - wpos) / (1 - wph) : ph * cl;
    pos >= cl ? pos -= cl;
    rd_interp(pos);
    outL = oL * env;
    outR = oR * env;

    odub_btn && state == ST_PLAY ? (
      ph2 = (b - lat_qn - start_qn) / loop_qn; ph2 -= floor(ph2);
      k = floor(ph2 * cl + 0.5); k >= cl ? k -= cl;
      BUF[2*k] += inL; BUF[2*k+1] += inR;
      k >= cl - nx ? ( k -= cl - nx; xfb[2*k] += inL; xfb[2*k+1] += inR; );
    );
  );

  b += qn_per_spl;
);

// remember the last input frames (for the seam of the next recording)
RING[2*ring_pos] = inL; RING[2*ring_pos+1] = inR;
ring_pos += 1; ring_pos >= XF_MAX ? ring_pos = 0;

spl0 = outL * gain + (thru ? inL : 0);
spl1 = outR * gain + (thru ? inR : 0);

@gfx 360 210
// ---------- display + clickable buttons ----------
gfx_set(0.08, 0.08, 0.1, 1); gfx_rect(0, 0, gfx_w, gfx_h);
gfx_setfont(1, "Arial", 14);
gfx_set(0.85, 0.85, 0.9, 1); gfx_x = 8; gfx_y = 6; gfx_drawstr("E4L Looper");

// state label
gfx_setfont(2, "Arial", 26, 'b');
state == ST_EMPTY ? ( gfx_set(0.55, 0.55, 0.6, 1); lbl = "EMPTY"; );
state == ST_REC   ? ( gfx_set(1, 0.25, 0.25, 1); lbl = "REC"; );
state == ST_PLAY  ? ( gfx_set(0.3, 0.9, 0.4, 1); lbl = odub_btn ? "PLAY + OVERDUB" : "PLAY"; );
state == ST_STOP  ? ( gfx_set(0.6, 0.75, 0.9, 1); lbl = "STOPPED"; );
state == ST_PAUSE ? ( gfx_set(1, 0.8, 0.3, 1); lbl = pend_resume ? "PAUSED - continues next bar" : "PAUSED"; );
armed ? ( gfx_set(1, 0.6, 0.2, 1); lbl = "ARMED - next bar"; );
gfx_x = 8; gfx_y = 26; gfx_drawstr(lbl);

gfx_setfont(1, "Arial", 13);
gfx_set(0.7, 0.7, 0.75, 1);
gfx_x = 8; gfx_y = 60;
gfx_printf("Length %d bars", bars_from_sel(len_sel));
pend_play ? gfx_drawstr("   (starts next bar)");
pend_stop ? gfx_drawstr("   (stops next bar)");
!(play_state & 1) ? ( gfx_set(1, 0.7, 0.3, 1); gfx_x = 8; gfx_y = 76;
  gfx_drawstr("Press play in REAPER to record / play loops"); );
err_msg ? ( gfx_set(1, 0.4, 0.3, 1); gfx_x = 8; gfx_y = 76;
  gfx_drawstr("Loop too long at this tempo: choose fewer bars"); );

// position bar with bar ticks
px = 8; py = 96; pw = gfx_w - 16; ph_ = 14;
gfx_set(0.2, 0.2, 0.24, 1); gfx_rect(px, py, pw, ph_);
(state == ST_PLAY || state == ST_REC) && loop_qn > 0 ? (
  bb = beat_position;
  ref = state == ST_REC ? rec_start_qn : start_qn;
  pp = (bb - ref) / loop_qn; pp -= floor(pp);
  state == ST_REC ? gfx_set(1, 0.25, 0.25, 0.9) : gfx_set(0.3, 0.9, 0.4, 0.9);
  gfx_rect(px, py, pw * pp, ph_);
);
nb = bars_from_sel(len_sel); has_loop && bar_qn > 0 ? nb = floor(loop_qn / bar_qn + 0.5);
gfx_set(0.5, 0.5, 0.55, 1);
k = 1; loop(nb - 1, gfx_line(px + pw * k / nb, py, px + pw * k / nb, py + ph_); k += 1; );

// buttons
function button(x, y, w, h, label, on, r, g, bl, idx)
(
  on ? gfx_set(r, g, bl, 1) : gfx_set(0.22, 0.22, 0.26, 1);
  gfx_rect(x, y, w, h);
  gfx_set(on ? 0.05 : 0.85, on ? 0.05 : 0.85, on ? 0.05 : 0.9, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) / 2; gfx_y = y + (h - th) / 2; gfx_drawstr(label);
  (mouse_cap & 1) && !last_cap && mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h ? (
    idx == 2 ? set_slider(2, rec_btn ? 0 : 1);
    idx == 3 ? set_slider(3, play_btn ? 0 : 1);
    idx == 4 ? set_slider(4, odub_btn ? 0 : 1);
    idx == 5 ? set_slider(5, 1);
    idx == 16 ? set_slider(16, pause_btn ? 0 : 1);
  );
);
gfx_setfont(3, "Arial", 13, 'b');
bw = (gfx_w - 16 - 4 * 6) / 5; by = 122; bh = 40;
button(8,               by, bw, bh, "REC",     armed || state == ST_REC, 1, 0.3, 0.3, 2);
button(8 + (bw + 6),    by, bw, bh, "PLAY",    play_btn, 0.3, 0.9, 0.4, 3);
button(8 + 2*(bw + 6),  by, bw, bh, "PAUSE",   pause_btn, 1, 0.8, 0.3, 16);
