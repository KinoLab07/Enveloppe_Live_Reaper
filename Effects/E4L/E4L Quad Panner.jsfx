desc: E4L Quad Panner (3rd order ambisonics)
//tags: ambisonics spatial panner envelop e4l
//author: Port of Envelop for Live (E4L) to REAPER
//
// Port of "E4L Quad Panner.amxd" from Envelop for Live (https://github.com/EnvelopSound/EnvelopForLive)
// Copyright (C) Envelop / Mark C. Slee and contributors. REAPER port: GPLv2 or later, see LICENSE.
//
// Encodes 4 inputs (1 front L, 2 front R, 3 rear L, 4 rear R) into 16 channels of
// 3rd order ambisonics (ambiX: ACN / SN3D), with the E4L LFOs.
//
// Azimuth Spread Mode (as in E4L):
//   LR : square. Front pair at azimuth -/+ spread/2, rear pair at azimuth+180 +/- spread/2
//   X  : like LR, but the rear pair is swapped (diagonals cross)
//   W  : fan. Front pair at -/+ W1(spread), rear pair at -/+ W2(spread), all around the azimuth
//
// Routing: set the track to 16 channels (the 4 quad channels on 1-4), send it
// (channels 1-16 -> 1-16) to the "E4L Master Bus" track, and disable the master send.

slider1:azim=0<-180,180,0.1>Azimuth
slider2:elev=0<-90,90,0.1>Elevation
slider3:radius=1<0,1,0.001>Radius
slider4:range=10<1,40,0.01>Range
slider5:azsp=90<-180,180,0.1>Azimuth Spread
slider6:elsp=0<-90,90,0.1>Elevation Spread
slider7:spmode=0<0,2,1{LR,X,W}>Azimuth Spread Mode

slider10:a_on=0<0,1,1{Off,On}>Azimuth LFO On/Off
slider11:a_mode=0<0,1,1{Cycle,Sin}>Azimuth LFO Mode
slider12:a_tmode=0<0,1,1{Freq,Sync}>Azimuth LFO Time Mode
slider13:a_freq=1<0.1,10,0.01>Azimuth LFO Frequency (Hz)
slider14:a_rate=1<-1,1,0.001>Azimuth LFO Rate
slider15:a_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Azimuth LFO Sync (bars)
slider16:a_dir=0<0,1,1{Clockwise,Counter}>Azimuth LFO Direction
slider17:a_depth=30<0,180,0.1>Azimuth LFO Depth

slider20:e_on=0<0,1,1{Off,On}>Elevation LFO On/Off
slider21:e_pol=0<0,1,1{Unipolar,Bipolar}>Elevation LFO Polarity
slider22:e_tmode=0<0,1,1{Freq,Sync}>Elevation LFO Time Mode
slider23:e_freq=1<0.1,10,0.01>Elevation LFO Frequency (Hz)
slider24:e_rate=1<-1,1,0.001>Elevation LFO Rate
slider25:e_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Elevation LFO Sync (bars)
slider26:e_dir=0<0,1,1{Clockwise,Counter}>Elevation LFO Direction
slider27:e_depth=30<0,90,0.1>Elevation LFO Depth

slider30:as_on=0<0,1,1{Off,On}>Azimuth Spread LFO On/Off
slider31:as_tmode=0<0,1,1{Freq,Sync}>Azimuth Spread LFO Mode
slider32:as_freq=1<0.01,4,0.001>Azimuth Spread LFO Frequency (Hz)
slider33:as_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Azimuth Spread LFO Sync (bars)
slider34:as_depth=30<0,180,0.1>Azimuth Spread LFO Depth

slider40:es_on=0<0,1,1{Off,On}>Elevation Spread LFO On/Off
slider41:es_tmode=0<0,1,1{Freq,Sync}>Elevation Spread LFO Mode
slider42:es_freq=1<0.01,4,0.001>Elevation Spread LFO Frequency (Hz)
slider43:es_sync=2<0,10,1{1/4,1/2,1,2,3,4,6,8,16,32,64}>Elevation Spread LFO Sync (bars)
slider44:es_depth=30<0,90,0.1>Elevation Spread LFO Depth

import e4l_ambix.jsfx-inc
import e4l_gfx.jsfx-inc

in_pin:Front L
in_pin:Front R
in_pin:Rear L
in_pin:Rear R
out_pin:W (ACN 0)
out_pin:Y (ACN 1)
out_pin:Z (ACN 2)
out_pin:X (ACN 3)
out_pin:ACN 4
out_pin:ACN 5
out_pin:ACN 6
out_pin:ACN 7
out_pin:ACN 8
out_pin:ACN 9
out_pin:ACN 10
out_pin:ACN 11
out_pin:ACN 12
out_pin:ACN 13
out_pin:ACN 14
out_pin:ACN 15

@init
ext_tail_size = -1;

// memory map: 4 sources x (cur, inc, tgt) of 16 values, plus scratch
sh  = 0;
cur = 16;    // cur + 16*k
inc = 80;
tgt = 144;
pos_az = 208; pos_el = 212;   // positions of the 4 sources (for the display)
xin = 216;

first = 1;
ctr = 0;
alfo.lfo_reset(); elfo.lfo_reset(); aslfo.lfo_reset(); eslfo.lfo_reset();

// "p W1" / "p W2" of the E4L Quad Panner: non-linear fan spread for the W mode
function quad_w1(x)
(
  abs(x) <= 90 ? x * 0.5 : x > 0 ? 180 - (180 - x) * 1.5 : (x + 180) * 1.5 - 180;
);
function quad_w2(x)
(
  abs(x) <= 90 ? x * 1.5 : x > 0 ? 180 - (180 - x) * 0.5 : (x + 180) * 0.5 - 180;
);

function set_source(k, az, el)
(
  pos_az[k] = az; pos_el[k] = el;
  e4l_encode_target(az, el, radius, range, sh, tgt + 16*k);
);

function compute_targets(bpos, n) local(az, el, s, e, h, w1, w2)
(
  az = alfo.e4l_azim_lfo(azim, a_on, a_mode, a_tmode, a_freq, a_rate, a_sync, a_dir, a_depth, bpos, n);
  el = elfo.e4l_pol_lfo(elev, e_on, e_pol, e_tmode, e_freq, e_rate, e_sync, e_dir, e_depth, bpos, n);
  s  = aslfo.e4l_spread_lfo(azsp, as_on, as_tmode, as_freq, as_sync, as_depth, bpos, n);
  e  = eslfo.e4l_spread_lfo(elsp, es_on, es_tmode, es_freq, es_sync, es_depth, bpos, n);
  h  = s * 0.5;

  spmode == 0 ? (            // LR
    set_source(0, az - h,       el + e);
    set_source(1, az + h,       el - e);
    set_source(2, az + 180 + h, el + e);
    set_source(3, az + 180 - h, el - e);
  ) : spmode == 1 ? (        // X
    set_source(0, az - h,       el + e);
    set_source(1, az + h,       el - e);
    set_source(2, az + 180 - h, el - e);
    set_source(3, az + 180 + h, el + e);
  ) : (                      // W
    w1 = quad_w1(s); w2 = quad_w2(s);
    set_source(0, az - w1, el + e);
    set_source(1, az + w1, el - e);
    set_source(2, az - w2, el + e);
    set_source(3, az + w2, el - e);
  );
);

@block
blk_beat = beat_position;
blk_spb  = tempo / 60 / srate;

@sample
ctr <= 0 ? (
  compute_targets(blk_beat, E4L_CTRL);
  first ? (
    memcpy(cur, tgt, 64); memset(inc, 0, 64); first = 0;
  ) : (
    k = 0;
    loop(4, enc_set_target(cur + 16*k, tgt + 16*k, inc + 16*k, E4L_CTRL); k += 1; );
  );
  ctr = E4L_CTRL;
);
ctr -= 1;
blk_beat += blk_spb;

xin[0] = spl0; xin[1] = spl1; xin[2] = spl2; xin[3] = spl3;
spl0 = spl1 = spl2 = spl3 = spl4 = spl5 = spl6 = spl7 = 0;
spl8 = spl9 = spl10 = spl11 = spl12 = spl13 = spl14 = spl15 = 0;

k = 0;
loop(4,
  c = cur + 16*k; d = inc + 16*k;
  enc_step(c, d);
  x = xin[k];
  spl0  += x*c[0];  spl1  += x*c[1];  spl2  += x*c[2];  spl3  += x*c[3];
  spl4  += x*c[4];  spl5  += x*c[5];  spl6  += x*c[6];  spl7  += x*c[7];
  spl8  += x*c[8];  spl9  += x*c[9];  spl10 += x*c[10]; spl11 += x*c[11];
  spl12 += x*c[12]; spl13 += x*c[13]; spl14 += x*c[14]; spl15 += x*c[15];
  k += 1;
);

@gfx 320 380
e4l_draw_header("E4L Quad Panner");
e4l_draw_top_view(pos_az[0], pos_el[0], radius, 0.2, 0.6, 1.0, "FL");
e4l_draw_top_view(pos_az[1], pos_el[1], radius, 1.0, 0.45, 0.3, "FR");
e4l_draw_top_view(pos_az[2], pos_el[2], radius, 0.4, 0.8, 1.0, "RL");
e4l_draw_top_view(pos_az[3], pos_el[3], radius, 1.0, 0.7, 0.4, "RR");
