desc: E4L Source Panner (3rd order ambisonics)
//tags: ambisonics spatial panner envelop e4l
//author: Port of Envelop for Live (E4L) to REAPER
//
// Port of "E4L Source Panner.amxd" from Envelop for Live (https://github.com/EnvelopSound/EnvelopForLive)
// by Mark C. Slee. Copyright (C) Envelop and contributors. REAPER port: GPLv2 or later, see LICENSE.
//
// Encodes a mono or stereo signal into 16 channels of 3rd order ambisonics (ambiX: ACN / SN3D).
// Position in Polar (azimuth / elevation / radius) or XYZ coordinates, with left/right spread.
// All parameters can be automated with REAPER envelopes or parameter modulation.
//
// XYZ axes (as in E4L): X = right, Y = front, Z = up, range -1..1.
//
// Routing: set the track to 16 channels, send it (channels 1-16 -> 1-16) to the track
// that holds "E4L Master Bus", and disable the track's master/parent send.

slider1:mode_st=1<0,1,1{Mono,Stereo}>Mono/Stereo
slider2:coord=1<0,1,1{XYZ,Polar}>Coordinate Mode
slider3:range=10<1,40,0.01>Range

slider5:azim=0<-180,180,0.1>Azimuth
slider6:elev=0<-90,90,0.1>Elevation
slider7:radius=1<0,1,0.001>Radius
slider8:azsp=30<-180,180,0.1>Azimuth-Spread
slider9:elsp=0<-90,90,0.1>Elevation-Spread

slider11:px=0<-1,1,0.001>X
slider12:py=1<-1,1,0.001>Y
slider13:pz=0<-1,1,0.001>Z
slider14:xsp=0.3<-1,1,0.001>X-Spread
slider15:ysp=0<-1,1,0.001>Y-Spread
slider16:zsp=0<-1,1,0.001>Z-Spread

import e4l_ambix.jsfx-inc
import e4l_gfx.jsfx-inc

in_pin:Left
in_pin:Right
out_pin:W (ACN 0)
out_pin:Y (ACN 1)
out_pin:Z (ACN 2)
out_pin:X (ACN 3)
out_pin:ACN 4
out_pin:ACN 5
out_pin:ACN 6
out_pin:ACN 7
out_pin:ACN 8
out_pin:ACN 9
out_pin:ACN 10
out_pin:ACN 11
out_pin:ACN 12
out_pin:ACN 13
out_pin:ACN 14
out_pin:ACN 15

@init
ext_tail_size = -1;
ext_noinit = 1;      // keep the movement (LFO phases) when REAPER starts / resumes

shL = 0;    shR = 16;
curL = 32;  incL = 48;  tgtL = 64;
curR = 80;  incR = 96;  tgtR = 112;
first = 1;
ctr = 0;

// Converts xyz to E4L az / el / radius, result in xyz_az / xyz_el / xyz_r
function xyz_to_aed(x, y, z)
(
  xyz_r  = sqrt(x*x + y*y + z*z);
  xyz_az = (x == 0 && y == 0) ? 0 : atan2(x, y) * 180 / $pi;
  xyz_el = xyz_r == 0 ? 0 : atan2(z, sqrt(x*x + y*y)) * 180 / $pi;
);

function encode_point(az, el, r, sh, tgt) ( e4l_encode_target(az, el, r, range, sh, tgt); );

function compute_targets()
(
  coord == 1 ? (
    mode_st ? (
      // As in E4L: left = azimuth - spread / elevation + spread, right = the opposite
      encode_point(azim - azsp, elev + elsp, radius, shL, tgtL);
      encode_point(azim + azsp, elev - elsp, radius, shR, tgtR);
      dLaz = azim - azsp; dLel = elev + elsp; dLr = radius;
      dRaz = azim + azsp; dRel = elev - elsp; dRr = radius;
    ) : (
      encode_point(azim, elev, radius, shL, tgtL);
      dLaz = azim; dLel = elev; dLr = radius;
    );
  ) : (
    mode_st ? (
      xyz_to_aed(px - xsp, py - ysp, pz - zsp);
      encode_point(xyz_az, xyz_el, xyz_r, shL, tgtL);
      dLaz = xyz_az; dLel = xyz_el; dLr = xyz_r;
      xyz_to_aed(px + xsp, py + ysp, pz + zsp);
      encode_point(xyz_az, xyz_el, xyz_r, shR, tgtR);
      dRaz = xyz_az; dRel = xyz_el; dRr = xyz_r;
    ) : (
      xyz_to_aed(px, py, pz);
      encode_point(xyz_az, xyz_el, xyz_r, shL, tgtL);
      dLaz = xyz_az; dLel = xyz_el; dLr = xyz_r;
    );
  );
);

@sample
ctr <= 0 ? (
  compute_targets();
  first ? (
    memcpy(curL, tgtL, 16); memcpy(curR, tgtR, 16);
    memset(incL, 0, 16);    memset(incR, 0, 16);
    first = 0;
  ) : (
    enc_set_target(curL, tgtL, incL, E4L_CTRL);
    enc_set_target(curR, tgtR, incR, E4L_CTRL);
  );
  ctr = E4L_CTRL;
);
ctr -= 1;

enc_step(curL, incL);
enc_step(curR, incR);

mode_st ? (
  inL = spl0; inR = spl1;
) : (
  inL = 0.5 * (spl0 + spl1); inR = 0;
);
spl0  = inL*curL[0]  + inR*curR[0];
spl1  = inL*curL[1]  + inR*curR[1];
spl2  = inL*curL[2]  + inR*curR[2];
spl3  = inL*curL[3]  + inR*curR[3];
spl4  = inL*curL[4]  + inR*curR[4];
spl5  = inL*curL[5]  + inR*curR[5];
spl6  = inL*curL[6]  + inR*curR[6];
spl7  = inL*curL[7]  + inR*curR[7];
spl8  = inL*curL[8]  + inR*curR[8];
spl9  = inL*curL[9]  + inR*curR[9];
spl10 = inL*curL[10] + inR*curR[10];
spl11 = inL*curL[11] + inR*curR[11];
spl12 = inL*curL[12] + inR*curR[12];
spl13 = inL*curL[13] + inR*curR[13];
spl14 = inL*curL[14] + inR*curR[14];
spl15 = inL*curL[15] + inR*curR[15];

@gfx 320 340
e4l_draw_header("E4L Source Panner");
mode_st ? (
  e4l_draw_top_view(dLaz, dLel, dLr, 0.2, 0.6, 1.0, "L");
  e4l_draw_top_view(dRaz, dRel, dRr, 1.0, 0.45, 0.3, "R");
) : (
  e4l_draw_top_view(dLaz, dLel, dLr, 0.3, 0.85, 0.6, "Mono");
);
